PORT=8088
MONGODB_URI="mongodb://localhost:27017/notesathi"
SECRET_KEY="merosecretjwtkey"

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gmail address to send password-reset emails from, and a 16-character
# App Password for it (NOT your normal Gmail password) — create one at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification on).
EMAIL_USER=
EMAIL_APP_PASSWORD=

# Base URL of the frontend, used to build the password reset link in emails.
FRONTEND_URL=http://localhost:3000
