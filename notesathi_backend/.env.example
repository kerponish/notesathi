PORT=8088
MONGODB_URI="mongodb://localhost:27017/notesathi"
SECRET_KEY="your-jwt-secret"

# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OAuth 2.0 Client ID from Google Cloud Console (Credentials -> OAuth client ID -> Web application).
# Must match NEXT_PUBLIC_GOOGLE_CLIENT_ID in notesathi_frontend/.env.
GOOGLE_CLIENT_ID=

# Gmail address + App Password (https://myaccount.google.com/apppasswords)
# used to send password-reset emails.
EMAIL_USER=
EMAIL_APP_PASSWORD=
FRONTEND_URL=http://localhost:3000
